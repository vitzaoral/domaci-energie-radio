# /etc/kotel-rf.env (chmod 600) – konfigurace démona kotel_rf.py serve
# Náhodný token: openssl rand -hex 24
KOTEL_RF_TOKEN=nahradte-nahodnym-tokenem
# Jen místní přístup. Na síť (např. VPN) otevírejte vědomě a nikdy ne do internetu.
KOTEL_RF_BIND=127.0.0.1
KOTEL_RF_PORT=8765
# Povolený rozsah denní teploty (pevná pojistka 10–28 °C platí vždy)
KOTEL_RF_MIN_C=14
KOTEL_RF_MAX_C=25
# Jak často číst hodnoty kotle v sekundách (0 = jen na vyžádání)
KOTEL_RF_INFO_INTERVAL=300
# Obecný zápis libovolného parametru (POST /set). Výchozí vypnuto.
KOTEL_RF_ALLOW_RAW_SET=0
# Záznam rámců po dnech (prázdné = nezapisovat)
KOTEL_RF_LOG_DIR=
